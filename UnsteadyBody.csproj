<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>UnsteadyBody</AssemblyName>
    <RootNamespace>UnsteadyBody</RootNamespace>
    <Version>0.1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- Change this to your Hollow Knight install folder. -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Hollow Knight</GameDir>
    <ManagedDir>$(GameDir)\hollow_knight_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets you build without the .NET Framework targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The game's assemblies. Assembly-CSharp must be the Modding API version
       that Lumafly installs, since that's where the Modding namespace lives.
       MMHOOK_Assembly-CSharp provides the On.HeroController hooks. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(ManagedDir)\MMHOOK_Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(ManagedDir)\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(ManagedDir)\PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The charm icon, built into the DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\UnsteadyBody.png" LogicalName="UnsteadyBody.png" />
  </ItemGroup>

  <!-- After a build, copy the mod straight into the Modding API's Mods folder. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(ManagedDir)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ManagedDir)\Mods\Unsteady Body" />
  </Target>

</Project>
